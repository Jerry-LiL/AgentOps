# local uses the built-in function-calling stand-in. Set openai to call the API.
AGENTOPS_LLM_MODE=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AGENTOPS_DB_PATH=./data/agentops.sqlite
AGENTOPS_DATA_DIR=./data

# Stop the worker loop after this many steps.
AGENTOPS_MAX_STEPS=8
AGENTOPS_TOOL_TIMEOUT_SECONDS=15
AGENTOPS_TOOL_RETRIES=2
AGENTOPS_RETRY_BACKOFF_SECONDS=0.2

# Test hook: the spreadsheet server fails this many writes before succeeding.
AGENTOPS_SPREADSHEET_FAIL_FIRST=0

AGENTOPS_HOST=0.0.0.0
AGENTOPS_PORT=8000
